# Server
HOST=127.0.0.1
PORT=8000
RELOAD=false

# Optional PostgreSQL storage for chat conversations and messages.
# Leave empty to keep using local SQLite for chat data.
CHAT_DATABASE_URL=

# Optional OpenAI-compatible provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Optional LangChain/Tavily web search for "手动" or time-sensitive "自动" queries
TAVILY_API_KEY=
