# Server
HOST=127.0.0.1
PORT=8000
RELOAD=false

# Optional PostgreSQL storage for chat conversations and messages.
# Leave empty to keep using local SQLite for chat data.
CHAT_DATABASE_URL=

# Optional OpenAI-compatible provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional comma-separated list shown in the model picker (first model remains OPENAI_MODEL)
OPENAI_MODELS=
OPENAI_BASE_URL=

# DeepSeek (official API; optional overrides for compatible gateways)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MODELS=
DEEPSEEK_BASE_URL=

# Google Gemini OpenAI-compatible API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODELS=
GEMINI_BASE_URL=

# Optional LangChain/Tavily web search for "手动" or time-sensitive "自动" queries
TAVILY_API_KEY=
